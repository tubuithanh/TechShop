PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_multistore_db
# Hoặc dùng MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce_multistore_db

# JWT
JWT_ACCESS_SECRET=thay_doi_chuoi_bi_mat_access_token
JWT_REFRESH_SECRET=thay_doi_chuoi_bi_mat_refresh_token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL (dùng cho CORS)
CLIENT_URL=http://localhost:5173

# Đăng nhập bằng Zalo (tạo app tại https://developers.zalo.me, chọn sản phẩm "Social API")
# ZALO_REDIRECT_URI phải khớp CHÍNH XÁC với "Callback URL" đã khai báo trong app Zalo, và trỏ vào
# chính backend (không phải frontend). Zalo bắt buộc Callback URL phải là https kể cả khi test
# local, nên cần tạo chứng chỉ tự ký: xem README hoặc chạy lệnh openssl tạo backend/certs/{key,cert}.pem
# rồi chạy server, backend sẽ tự mở thêm cổng HTTPS_PORT chỉ để phục vụ callback này.
HTTPS_PORT=5443
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://localhost:5443/api/auth/zalo/callback

# (Tùy chọn) Cổng thanh toán VNPay - đăng ký sandbox miễn phí tại https://sandbox.vnpayment.vn/devreg
# Bỏ trống thì nút "Thanh toán qua VNPay" báo chưa cấu hình (đơn vẫn tạo được, thanh toán lại sau).
# Trên VNPay, khai báo IPN URL = <backend>/api/payments/vnpay/ipn
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang kết quả phía frontend (mặc định: CLIENT_URL + /payment/vnpay-return)
VNP_RETURN_URL=

# (Tùy chọn) Cloudinary - upload ảnh. Bỏ trống thì ảnh được lưu vào thư mục backend/uploads của máy chủ
# (ổ đĩa Render không bền - production nên cấu hình Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
